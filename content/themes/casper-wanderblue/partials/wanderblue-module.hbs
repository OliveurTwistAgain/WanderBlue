{{!-- style pour le module wanderblue --}}
<link rel="stylesheet" href="{{asset "css/wanderblue-module.css"}}">

{{!-- ====================================================== --}}
{{!-- FORMULAIRE DE RECHERCHE + CARTE LEAFLET             --}}
{{!-- ====================================================== --}}
<section id="lieux" class="outer">
    <div class="inner posts">
        <h2 class="post-card-favorites-title">Recherche de lieux à visiter</h2>

        {{!-- Formulaire de recherche principal --}}
        <form id="location-search-form" class="search-form" role="search" aria-label="Recherche de lieux">
            <div class="search-input-group">
                <input type="search" id="location-input" placeholder="Entrez une ville" required aria-required="true">
                <button type="submit" aria-label="Rechercher" class="search-button">
                    {{> "icons/search"}}
                </button>
            </div>
        </form>

        {{!-- Conteneur de la carte Leaflet --}}
        <div id="map" class="map-container"></div>
    </div>
</section>

{{!-- ====================================================== --}}
{{!-- RÉSULTATS DES 6 LIEUX LES PLUS PROCHES               --}}
{{!-- ====================================================== --}}
<section id="nearby-results" class="outer" style="display:none;">
    <div class="inner posts">
        <h2 class="post-card-title" id="nearby-title">Résultats proches</h2>
        <div class="post-suggestions" id="nearby-posts">
            {{#foreach posts}}
                <article class="post-card">
                    {{!-- Affichage de l'image si présente --}}
                    {{#if feature_image}}
                        <a href="/{{slug}}" class="post-card-image-link">
                            <img class="post-card-image"
                                srcset="{{img_url feature_image size="s"}} 300w,
                                        {{img_url feature_image size="m"}} 600w,
                                        {{img_url feature_image size="l"}} 1000w,
                                        {{img_url feature_image size="xl"}} 2000w"
                                sizes="(max-width: 1000px) 400px, 800px"
                                src="{{img_url feature_image size="m"}}"
                                alt="{{title}}" loading="lazy">
                        </a>
                    {{/if}}
                    
                    <div class="post-card-content">
                        <header class="post-card-header">
                            <div class="post-card-tags">
                                {{#primary_tag}}
                                    <span class="post-card-primary-tag">{{name}}</span>
                                {{/primary_tag}}
                            </div>
                            <h3 class="post-card-title">
                                <a href="/{{slug}}">{{title}}</a>
                            </h3>
                        </header>
                        {{#if excerpt}}
                            <p class="post-card-excerpt">{{excerpt}}</p>
                        {{/if}}
                    </div>
                </article>
            {{/foreach}}
        </div>
    </div>
</section>

{{!-- ====================================================== --}}
{{!-- SCRIPT : RECHERCHE + CARTE LEAFLET                     --}}
{{!-- ====================================================== --}}
<script>
document.addEventListener("DOMContentLoaded", () => {
    const form = document.getElementById('location-search-form');
    const input = document.getElementById('location-input');
    const mapDiv = document.getElementById('map');
    const nearbySection = document.getElementById('nearby-results');
    const nearbyContainer = document.getElementById('nearby-posts');
    const nearbyTitle = document.getElementById('nearby-title');

    // --- Carte initiale centrée sur la France
    const map = L.map(mapDiv).setView([48.8566, 2.3522], 5);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap contributors',
        maxZoom: 18
    }).addTo(map);

    let markers = [];

    function calculateDistance(lat1, lon1, lat2, lon2) {
        const R = 6371;
        const dLat = (lat2 - lat1) * Math.PI / 180;
        const dLon = (lon2 - lon1) * Math.PI / 180;
        const a = Math.sin(dLat / 2) ** 2 +
                  Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
                  Math.sin(dLon / 2) ** 2;
        return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
    }

    function getLatLon(post) {
        const latMatch = post.codeinjection_head?.match(/<meta\s+name="latitude"\s+content="([\d.-]+)"/);
        const lonMatch = post.codeinjection_foot?.match(/<meta\s+name="longitude"\s+content="([\d.-]+)"/);
        return (latMatch && lonMatch) ? { lat: parseFloat(latMatch[1]), lon: parseFloat(lonMatch[1]) } : null;
    }

    function displayNearby(city, posts) {
        nearbyContainer.innerHTML = '';
        nearbyTitle.textContent = `Suggestions pour "${city}"`;

        if (posts.length === 0) {
            nearbyContainer.innerHTML = `<p>Aucun lieu trouvé pour "${city}"</p>`;
            nearbySection.style.display = 'block';
            return;
        }

        const bounds = L.latLngBounds([]);
        posts.forEach(post => {
            // --- Primary tag : on teste post.primary_tag sinon post.tags[0]
            const primaryTag = post.primary_tag || (post.tags && post.tags[0]);
            const tagsHTML = primaryTag ? `<span class="post-card-primary-tag">${primaryTag.name}</span>` : '';

            // --- Popup Leaflet
            const popupHTML = `
                ${post.feature_image ? `<img src="${post.feature_image}" alt="${post.title}" style="width:80%;border-radius:6px;margin-bottom:5px;">` : ''}
                <div class="post-card-tags">${tagsHTML}</div>
                <h3 style="margin:5px 0;"><a href="/${post.slug}">${post.title}</a></h3>
                <p style="margin:0;">${post.excerpt || ''}</p>
            `;
            const marker = L.marker([post.lat, post.lon]).addTo(map)
                .bindPopup(popupHTML);
            markers.push(marker);
            bounds.extend([post.lat, post.lon]);

            // --- Carte HTML comme "coups de coeur"
            nearbyContainer.insertAdjacentHTML('beforeend', `
                <article class="post-card post ${primaryTag ? 'tag-' + primaryTag.slug : ''}">
                    <a class="post-card-image-link" href="/${post.slug}">
                        ${post.feature_image ? `<img src="${post.feature_image}" alt="${post.title}" class="post-card-image">` : ''}
                    </a>
                    <div class="post-card-content">
                        <a class="post-card-content-link" href="/${post.slug}">
                            <header class="post-card-header">
                                <div class="post-card-tags">${tagsHTML}</div>
                                <h2 class="post-card-title">${post.title}</h2>
                            </header>
                            <div class="post-card-excerpt">${post.excerpt || ''}</div>
                        </a>
                    </div>
                </article>
            `);
        });

        map.fitBounds(bounds);
        nearbySection.style.display = 'block';
    }

    form.addEventListener('submit', async e => {
        e.preventDefault();
        const city = input.value.trim();
        if (!city) return;

        const geoRes = await fetch(`https://nominatim.openstreetmap.org/search?q=${encodeURIComponent(city)}&format=json&limit=1`);
        const geoData = await geoRes.json();
        if (geoData.length === 0) return alert("Ville introuvable");

        const cityLat = parseFloat(geoData[0].lat);
        const cityLon = parseFloat(geoData[0].lon);

        markers.forEach(m => m.remove());
        markers = [];

        const apiUrl = window.GHOST_API_URL || "";
        const apiKey = window.GHOST_API_KEY || "";

        if (!apiUrl || !apiKey || apiKey === "your_content_api_key") {
            alert("⚠️ Recherche désactivée : clé API non configurée.");
            return;
        }

        try {
            const res = await fetch(`${apiUrl}?key=${apiKey}&limit=all&fields=title,slug,codeinjection_head,codeinjection_foot,feature_image,excerpt&include=tags,primary_tag`);
            const data = await res.json();

            // debug tags
            console.log(data.posts.map(p => ({title: p.title, primary_tag: p.primary_tag, tags: p.tags})));

            if (!data.posts || !Array.isArray(data.posts)) throw new Error("Réponse API invalide");

            const postsWithCoords = data.posts.map(p => {
                const coords = getLatLon(p);
                return coords ? { ...p, lat: coords.lat, lon: coords.lon, distance: calculateDistance(cityLat, cityLon, coords.lat, coords.lon) } : null;
            }).filter(Boolean);

            postsWithCoords.sort((a, b) => a.distance - b.distance);
            const closest6 = postsWithCoords.slice(0, 6);

            displayNearby(city, closest6);
        } catch (err) {
            console.error("Erreur API Ghost :", err);
            alert("Impossible de charger les articles (voir console).");
        }
    });
});
</script>
